import os
from building import *

cwd     = GetCurrentDir()
CPPPATH = [cwd]
libpath = [cwd + '/../custom']
CPPPATH += [cwd + '/../custom']
# Add source code
src = Glob('*.c')
src = src + Glob('/../custom/*.c') 
src = src + Glob('./guider_customer_fonts*/.c') 
src = src + Glob('./guider_fonts/*.c') 
src = src + Glob('./images/*.c') 

group = DefineGroup('Applications', src, depend = [''], CPPDEFINES = CPPDEFINES, 
    CPPPATH = CPPPATH,
    LIBS = ['libetasr_watch_sifli567'],
    LIBPATH = libpath)

Return('group')

